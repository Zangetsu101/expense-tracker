{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expense-tracker-expo",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expensetrackerexpo",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.zangetsu101.expensetracker",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#101820",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/monochrome-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101820",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "./plugins/with-android-release-signing.cjs",
      "./plugins/with-gradle-mirror.cjs",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a5e575d5-8792-4775-b5c7-1b4eea907b3e"
      }
    },
    "owner": "zangetsu101",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a5e575d5-8792-4775-b5c7-1b4eea907b3e",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}

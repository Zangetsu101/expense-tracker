{
  "name": "expense-tracker-expo",
  "main": "./index.js",
  "type": "module",
  "version": "0.2.3",
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@expo/ui": "~58.0.28",
    "@react-native-google-signin/google-signin": "16.1.5",
    "@tanstack/react-query": "^5.106.1",
    "expo": "~58.0.25",
    "expo-background-task": "~58.0.13",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "pnpm start --android",
    "android:prebuild": "expo prebuild --platform android --no-install",
    "android:apk": "bash scripts/build-android-apk.sh",
    "ios": "pnpm start --ios",
    "web": "expo start --web",
    "test": "pnpm test:node && pnpm test:ui",
    "test:backup": "node scripts/check-backup-format.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:backup && pnpm native:fingerprint",
    "test:node": "node --test src/lib/*.node.test.ts src/features/*/*.node.test.ts scripts/*.node.test.ts",
    "test:ui": "jest --runInBand",
    "android:apk:emulator": "bash scripts/build-emulator-apk.sh",
    "release:bump": "node scripts/release-bump.mjs",
    "native:fingerprint": "node scripts/native-fingerprint.mjs"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "!(*.{js,cjs,mjs,jsx,ts,tsx})": "prettier --write --ignore-unknown"
  },
  "private": true,
  "packageManager": "pnpm@10.33.2"
}

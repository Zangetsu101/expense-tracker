    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "pnpm start --android",
    "android:prebuild": "expo prebuild --platform android --no-install",
    "android:apk": "bash scripts/build-android-apk.sh",
    "ios": "pnpm start --ios",
    "web": "expo start --web",
    "test": "node --test src/lib/*.test.mjs src/components/*.test.mjs scripts/*.test.mjs",
    "test:backup": "node scripts/check-backup-format.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "pnpm lint --fix",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:backup"
  },
  "private": true,
  "packageManager": "pnpm@10.33.2"
